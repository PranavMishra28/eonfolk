{
	"name": "@eonfolk/web",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"build": "vite build",
		"dev": "vite --host 127.0.0.1",
		"preview": "vite preview",
		"test": "vitest run",
		"test:e2e": "pnpm test:e2e:fault && pnpm build && pnpm test:e2e:production",
		"test:e2e:fault": "playwright test --config playwright.fault.config.ts",
		"test:e2e:production": "playwright test --config playwright.config.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@eonfolk/cognition": "workspace:*",
		"@eonfolk/diagnostics": "workspace:*",
		"@eonfolk/persistence": "workspace:*",
		"@eonfolk/protocol": "workspace:*",
		"@eonfolk/sim": "workspace:*",
		"pixi.js": "8.19.0",
		"react": "19.2.8",
		"react-dom": "19.2.8"
	},
	"devDependencies": {
		"@playwright/test": "1.62.1",
		"@types/node": "22.20.1",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@vitejs/plugin-react": "6.1.0",
		"typescript": "7.0.2",
		"vite": "8.2.2",
		"vitest": "4.1.11"
	}
}
